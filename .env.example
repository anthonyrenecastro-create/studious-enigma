# =========================
# Core backend configuration
# =========================

# Gemini key used by Atlantean backend for LLM generation.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Flask session security.
ATLANTEAN_SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
SESSION_COOKIE_SECURE=0

# Comma-separated CORS allowlist for backend APIs.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Redis host for primary low-latency persistence.
REDIS_HOST=localhost


# ========================================
# Optional AWS persistence (dual-write)
# ========================================
# Modes: none | dynamodb | aurora | both
AWS_DB_MODE=none
AWS_REGION=us-east-1

# ---------- DynamoDB ----------
# If table names are omitted, the prefix values are used to derive defaults.
AWS_DYNAMODB_TABLE_PREFIX=atlantean
AWS_DYNAMODB_EVENTS_TABLE=atlantean_events
AWS_DYNAMODB_SNAPSHOTS_TABLE=atlantean_snapshots
AWS_DYNAMODB_CHECKPOINTS_TABLE=atlantean_checkpoints

# ---------- Aurora (RDS Data API) ----------
# Required when AWS_DB_MODE is aurora or both.
AWS_AURORA_CLUSTER_ARN=
AWS_AURORA_SECRET_ARN=
AWS_AURORA_DATABASE=atlantean
AWS_AURORA_EVENTS_TABLE=atlantean_events
AWS_AURORA_SNAPSHOTS_TABLE=atlantean_snapshots
AWS_AURORA_CHECKPOINTS_TABLE=atlantean_checkpoints
