# Fly.io-optimised Python backend image.
# Uses CPU-only torch to keep image size reasonable (~1.2 GB vs ~3+ GB with CUDA).

FROM python:3.12-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends gcc && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies.
# torch is pinned to CPU-only wheel to avoid pulling in CUDA libraries.
COPY requirements.txt .
RUN grep -v '^torch==' requirements.txt > /tmp/req_no_torch.txt && \
    pip install --no-cache-dir -r /tmp/req_no_torch.txt && \
    pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.2.0

# Copy application source
COPY . .

# Fly injects PORT; default to 8080 to match fly.toml
ENV PORT=8080

EXPOSE 8080

CMD ["python", "atlantean_backend.py"]
